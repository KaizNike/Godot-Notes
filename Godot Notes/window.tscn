[gd_scene load_steps=5 format=3 uid="uid://cjwjsiruajelx"]

[ext_resource type="Script" uid="uid://bl17po06jexqr" path="res://window.gd" id="1_8g44g"]
[ext_resource type="PackedScene" uid="uid://blet0tsxx2c2u" path="res://check_list_item.tscn" id="2_oiur5"]
[ext_resource type="Script" uid="uid://dwv8a5uck557s" path="res://TextEdit.gd" id="3_obcx1"]
[ext_resource type="PackedScene" uid="uid://bcy324tvyg3hu" path="res://clock_list_item.tscn" id="3_srjdr"]

[node name="Window" type="Window" groups=["Persist"]]
oversampling_override = 1.0
title = "Godot Notes!"
initial_position = 1
size = Vector2i(275, 275)
script = ExtResource("1_8g44g")
checkList = ExtResource("2_oiur5")
clockList = ExtResource("3_srjdr")

[node name="VBoxContainer" type="VSplitContainer" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
size_flags_horizontal = 4
size_flags_vertical = 4
dragger_visibility = 2

[node name="HBoxContainer" type="HBoxContainer" parent="VBoxContainer"]
layout_mode = 2

[node name="AddNoteButton" type="Button" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
tooltip_text = "New Note"
accessibility_name = "New Note Button"
accessibility_description = "Pops up a new window accessible by alt tab or window switching key(s)."
text = " + "

[node name="TitleEditor" type="LineEdit" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
size_flags_horizontal = 3
tooltip_text = "Note Title"
accessibility_name = "Note Title"
accessibility_description = "Describe what you will use the note for!"
placeholder_text = "First Note"

[node name="ClockButton" type="Button" parent="VBoxContainer/HBoxContainer"]
custom_minimum_size = Vector2(25, 0)
layout_mode = 2
tooltip_text = "Add to Checklist"
accessibility_name = "Clock Button"
accessibility_description = "Adds a clock to the bottom of the items list under the text body. Naviable by Ctrl tab or Ctrl Shift Tab."
text = "(L)"

[node name="CheckButton" type="Button" parent="VBoxContainer/HBoxContainer"]
custom_minimum_size = Vector2(25, 0)
layout_mode = 2
tooltip_text = "Add to Checklist"
accessibility_name = "Checklist Add Button"
accessibility_description = "Adds a checkable line item to the bottom of the items list under the text body. Naviable by Ctrl tab or Ctrl Shift Tab."
text = "*"

[node name="FocusButton" type="Button" parent="VBoxContainer/HBoxContainer"]
layout_mode = 2
tooltip_text = "Pin on Top"
accessibility_name = "Focus Button"
accessibility_description = "On clicking forces window to be on top of all windows."
toggle_mode = true
text = " ^ "

[node name="ScrollContainer" type="ScrollContainer" parent="VBoxContainer"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="VBoxContainer2" type="VBoxContainer" parent="VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
size_flags_stretch_ratio = 3.0

[node name="TextEdit" type="TextEdit" parent="VBoxContainer/ScrollContainer/VBoxContainer2"]
custom_minimum_size = Vector2(0, 75)
layout_mode = 2
size_flags_vertical = 3
size_flags_stretch_ratio = 3.0
tooltip_text = "Note Body - Write Here!"
accessibility_name = "Note Body"
accessibility_description = "Write here! Here's a further description: Type here! Ctrl + S saves.Ctrl + Tab/Ctrl + Shift Tab to NavigateCtrl + - New Note,Ctrl + L - Timer* - Add Item to Checklist^ - Pin Window to topF2 - Toggle Speech"
accessibility_live = 1
placeholder_text = "Type here! Ctrl + S saves.
Ctrl + Tab/Ctrl + Shift Tab to Navigate
Ctrl + - New Note,
Ctrl + L - Timer
* - Add Item to Checklist
^ - Pin Window to top
F2 - Toggle Speech"
wrap_mode = 1
draw_tabs = true
script = ExtResource("3_obcx1")

[node name="Popup" type="Popup" parent="."]
title = "Notes saved."
initial_position = 4
unresizable = false
borderless = false

[node name="PanelContainer" type="PanelContainer" parent="Popup"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Label" type="Label" parent="Popup/PanelContainer"]
layout_mode = 2
text = "Saved"
horizontal_alignment = 1

[node name="PopupTimer" type="Timer" parent="."]
wait_time = 8.0

[connection signal="close_requested" from="." to="." method="_on_close_requested"]
[connection signal="focus_entered" from="." to="." method="_on_focus_entered"]
[connection signal="gui_focus_changed" from="." to="." method="_on_gui_focus_changed"]
[connection signal="pressed" from="VBoxContainer/HBoxContainer/AddNoteButton" to="." method="_on_add_button_pressed"]
[connection signal="text_changed" from="VBoxContainer/HBoxContainer/TitleEditor" to="." method="_on_title_editor_text_changed"]
[connection signal="pressed" from="VBoxContainer/HBoxContainer/ClockButton" to="." method="_on_clock_button_pressed"]
[connection signal="pressed" from="VBoxContainer/HBoxContainer/CheckButton" to="." method="_on_check_button_pressed"]
[connection signal="toggled" from="VBoxContainer/HBoxContainer/FocusButton" to="." method="_on_focus_button_toggled"]
[connection signal="timeout" from="PopupTimer" to="." method="_on_popup_timer_timeout"]
